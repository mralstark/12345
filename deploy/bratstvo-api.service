[Unit]
Description=Личный кабинет Братства — бэкенд Mini App (FastAPI/uvicorn)
After=network-online.target postgresql.service bratstvo-api.socket
Wants=network-online.target
# Порт открывает сокет-юнит и передаёт готовым — см. bratstvo-api.socket,
# там же объяснено зачем.
Requires=bratstvo-api.socket

[Service]
Type=simple
User=bratstvo
Group=bratstvo
WorkingDirectory=/opt/bratstvo
# Порт не открываем сами, а принимаем от systemd готовым (дескриптор 3):
# так перезапуск не рвёт соединения. Адрес и порт заданы в bratstvo-api.socket.
# Nginx logs requests without query strings. Uvicorn's duplicate access log
# includes signed media/download tokens, so keep only error logs here.
ExecStart=/opt/bratstvo/.venv/bin/python -m uvicorn api.main:app --fd 3 --no-access-log
Restart=always
RestartSec=5
# Сервер может быть общим: предел памяти не даёт нам утащить за собой соседей.
# A bounded decoder handles one photo (up to 25 MP) at a time. Its transient
# EXIF/resize buffers must fit alongside the API; 350M killed valid phone uploads.
MemoryMax=768M
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/bratstvo

[Install]
WantedBy=multi-user.target
