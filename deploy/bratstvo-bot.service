[Unit]
Description=Личный кабинет Братства — Telegram-бот (aiogram)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=bratstvo
Group=bratstvo
WorkingDirectory=/opt/bratstvo
LoadCredential=data-keyring:/run/bratstvo-keys/data-keyring.json
StateDirectory=bratstvo-bot
StateDirectoryMode=0700
# .env читает сам python-dotenv из WorkingDirectory — EnvironmentFile не нужен.
ExecStart=/opt/bratstvo/.venv/bin/python bot.py
Restart=always
RestartSec=5
# Сервер может быть общим: предел памяти не даёт нам утащить за собой соседей.
MemoryMax=350M
MemorySwapMax=0
LimitCORE=0
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/bratstvo

[Install]
WantedBy=multi-user.target
