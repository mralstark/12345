[Unit]
Description=Порт кабинета Братства — держится системой, а не приложением

# Смысл этого файла — убрать разрыв при деплое. Раньше порт открывало само
# приложение: перезапуск убивал старый процесс, а новый открывал порт лишь
# через полтора десятка секунд (загрузка Python, FastAPI и Pillow). Всё это
# время nginx стучался в пустоту и отдавал 502 — замерено, двадцать запросов
# из ста двадцати пяти оставались без ответа.
#
# Теперь порт открывает systemd и передаёт его приложению готовым. При
# перезапуске порт остаётся открытым: запросы копятся в очереди ядра и
# обслуживаются, как только новый процесс поднимется. Никто не получает отказ,
# самое худшее — ожидание.

[Socket]
# Только localhost: наружу отдаёт nginx с TLS. Порт подставляет setup_server.sh.
ListenStream=127.0.0.1:__PORT__

[Install]
WantedBy=sockets.target
