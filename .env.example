# Режим production включает строгую проверку обязательных настроек.
APP_ENV=development
# New Academy = books and vocabulary. 0 is for deliberate legacy rollback only.
ACADEMY_LEGACY_READ_ONLY=1

# Только для локального просмотра Mini App без Telegram. Укажите один из ID,
# созданных scripts.seed_demo; в production значение обязано быть пустым.
DEV_TELEGRAM_ID=

# Получите токен у BotFather. Никогда не коммитьте заполненный .env.
BOT_TOKEN=
BOT_PROXY_URL=
# Optional Telegram recipient for operational failure/recovery alerts.
# Keep empty until the owner explicitly chooses a user/chat; no broadcast.
OPERATIONS_ALERT_TELEGRAM_ID=

# Публичный HTTPS origin Mini App без пути и завершающего слеша.
WEBAPP_URL=https://lk.example.com
# Public application ID from VK ID. Empty keeps VK sign-in disabled.
# Register https://YOUR_HOST/api/auth/vk/callback as the exact redirect URL.
VK_ID_CLIENT_ID=
# VK Mini Apps uses its own application ID and protected server-only key.
# Keep both empty to disable this integration. Never put the secret in JS/Git.
VK_MINI_APP_ID=
VK_MINI_APP_SECRET=
API_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=lk.example.com
# Обычно оставьте пустым: Mini App и API работают с одного origin.
CORS_ALLOWED_ORIGINS=

DATABASE_URL=sqlite+aiosqlite:///bratstvo.db
APP_TIMEZONE=Europe/Moscow
STORAGE_DIR=storage
MAX_UPLOAD_MB=25
MAX_STORAGE_MB=5120
MIN_FREE_STORAGE_MB=512

# Только числовые Telegram ID, через запятую.
SUPERUSER_TELEGRAM_IDS=
AUTO_FEDERAL_TELEGRAM_IDS=
PRIMARY_REVIEWER_FULL_NAME=

# Отдельный случайный ключ для короткоживущих ссылок на закрытые медиа.
# Создать: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIA_SIGNING_KEY=
# Private absolute keyring path; never put the key in .env, Git, uploads or DB backups.
# Generate with: python -m scripts.data_encryption generate-key --output /private/data-keyring.json
DATA_ENCRYPTION_KEY_FILE=
# Encrypted administrative identifiers/names, prepared during migration.
DATA_BOOTSTRAP_CIPHERTEXT=
# Required in production: encrypted token, DB URL and signing/proxy/provider secrets.
# Prepare with seal-runtime, then clear their plaintext variables above.
DATA_RUNTIME_CIPHERTEXT=
