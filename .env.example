# Режим production включает строгую проверку обязательных настроек.
APP_ENV=development

# Получите токен у BotFather. Никогда не коммитьте заполненный .env.
BOT_TOKEN=
BOT_PROXY_URL=

# Публичный HTTPS origin Mini App без пути и завершающего слеша.
WEBAPP_URL=https://lk.example.com
API_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=lk.example.com
# Обычно оставьте пустым: Mini App и API работают с одного origin.
CORS_ALLOWED_ORIGINS=

DATABASE_URL=sqlite+aiosqlite:///bratstvo.db
APP_TIMEZONE=Europe/Moscow
STORAGE_DIR=storage
MAX_UPLOAD_MB=25
MAX_STORAGE_MB=5120
MIN_FREE_STORAGE_MB=512

# Только числовые Telegram ID, через запятую.
SUPERUSER_TELEGRAM_IDS=
AUTO_FEDERAL_TELEGRAM_IDS=
PRIMARY_REVIEWER_FULL_NAME=

# Отдельный случайный ключ для короткоживущих ссылок на закрытые медиа.
# Создать: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIA_SIGNING_KEY=
